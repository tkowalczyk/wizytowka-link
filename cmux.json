      "confirm": true
    },
    {
      "name": "Open Production",
      "description": "Open wizytowka.link in browser",
      "keywords": ["production", "prod", "site", "live", "website"],
      "command": "open https://wizytowka.link"
    },
    {
      "name": "Open GitHub",
      "description": "Open GitHub repository in browser",
      "keywords": ["github", "repo", "repository", "code"],
      "command": "open https://github.com/tkowalczyk/wizytowka-link"
    }
  ]
}
