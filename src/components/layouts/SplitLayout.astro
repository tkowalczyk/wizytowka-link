---
import type { SiteData } from '../../types/site';
import type { PublicBusinessPageModel } from '../../lib/public-page';
import AuditmosFooterLink from '../AuditmosFooterLink.astro';
import AssistantChat from '../AssistantChat.astro';
import CategoryLogo from '../CategoryLogo.astro';
import { slugify } from '../../lib/slug';

interface RelatedBusiness {
  title: string;
  slug: string;
  category: string;
}

interface Props {
  site: SiteData;
  page: PublicBusinessPageModel;
  category: string;
  slug: string;
  locSlug: string;
  locName: string;
  locLabel: string;
  relatedBusinesses: RelatedBusiness[];
}

const { site, page, category, slug, locSlug, locName, locLabel, relatedBusinesses } = Astro.props;
---

<Fragment>

  <section class="hero-section bg-gradient-to-br from-hero to-hero-end text-hero-foreground px-4">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div class="md:w-2/3">
        <h1 class="hero-title">{site.hero.headline}</h1>
        <p class="hero-sub text-hero-accent">{site.hero.subheadline}</p>
        <p class="text-sm opacity-80 mt-2">{locLabel}</p>
        {category && (
          <a
            href={`/${locSlug}/kategoria/${slugify(category)}`}
            class="mt-3 inline-flex items-center gap-1 text-sm underline underline-offset-4 opacity-80 transition-opacity hover:opacity-100"
          >
            <span aria-hidden="true">←</span>
            Więcej firm z kategorii „{category}”
          </a>
        )}
        <span class="hero-divider !mx-0" aria-hidden="true"></span>
      </div>
      <div class="md:w-1/3 flex flex-col items-center md:items-end gap-6">
        <CategoryLogo category={category} />
      </div>
    </div>
  </section>

  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="section-title mb-4">{site.about.title}</h2>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-3xl">{page.aboutText}</p>
    </div>
  </section>

  <section class="bg-muted py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="section-title mb-10">Usługi</h2>
      <ul class="grid md:grid-cols-2 gap-6 list-none p-0 m-0">
        {page.services.map((s) => (
          <li class="card bg-card text-card-foreground">
            <h3 class="text-xl font-semibold mb-2">{s.name}</h3>
            <p class="text-muted-foreground">{s.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-primary text-primary-foreground py-16 px-4">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="space-y-2">
        <h2 class="section-title mb-2">Lokalizacja</h2>
        <address class="text-lg not-italic opacity-90">{page.location.address}</address>
        {page.location.openingHours && <p class="text-sm opacity-80">Godziny otwarcia: {page.location.openingHours}</p>}
        {page.location.mapHref && (
          <a href={page.location.mapHref} class="inline-flex text-sm underline underline-offset-4 hover:opacity-80" target="_blank" rel="noreferrer">
            Mapa i dojazd
          </a>
        )}
      </div>
      <AssistantChat
        locSlug={locSlug}
        businessSlug={slug}
        label={page.assistantCtaLabel}
        firstMessage={page.chat.firstMessage}
        privacyNotice={page.chat.privacyNotice}
        buttonClass="cta bg-accent text-accent-foreground"
      />
    </div>
  </section>

  {relatedBusinesses.length > 0 && (
    <section class="py-12 px-4 border-t border-border">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-lg font-semibold mb-6">Inne firmy w {locName}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedBusinesses.map((b) => (
            <a href={`/${locSlug}/${b.slug}`} class="block p-4 rounded-lg border border-border hover:bg-muted transition-colors">
              <span class="font-medium text-foreground">{b.title}</span>
              {b.category && <span class="text-sm text-muted-foreground block mt-1">{b.category}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <footer class="py-6 text-center text-sm text-muted-foreground">
    <p>Strona wygenerowana przez <a href="https://wizytowka.link" class="underline hover:text-foreground transition-colors">wizytowka.link</a></p>
    <AuditmosFooterLink class="mt-1" />
  </footer>

</Fragment>
