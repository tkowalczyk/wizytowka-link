---
interface Props {
	locSlug: string;
	businessSlug: string;
	label: string;
	firstMessage: string;
	privacyNotice: string;
	buttonClass: string;
}

const {
	locSlug,
	businessSlug,
	label,
	firstMessage,
	privacyNotice,
	buttonClass,
} = Astro.props;
---

<div class="assistant-chat w-full sm:w-auto" data-assistant-chat>
  <button type="button" class={buttonClass} data-chat-open>
    {label}
  </button>
  <div
    class="mt-6 hidden rounded-lg border border-border bg-card p-4 text-card-foreground shadow-lg"
    data-chat-panel
    role="dialog"
    aria-label="Chat z asystentem"
  >
    <div class="space-y-4">
      <div class="space-y-3" data-chat-messages role="log" aria-live="polite" aria-relevant="additions text">
        <div class="rounded-lg bg-muted p-4 text-sm leading-relaxed text-foreground">
          {firstMessage}
        </div>
      </div>
      <form class="space-y-2" data-chat-form>
        <label class="sr-only" for={`assistant-message-${locSlug}-${businessSlug}`}>Wiadomość</label>
        <textarea
          id={`assistant-message-${locSlug}-${businessSlug}`}
          class="min-h-24 w-full rounded-md border border-border bg-background p-3 text-sm text-foreground"
          placeholder="Napisz wiadomość"
          disabled
          data-chat-input
        ></textarea>
        <div class="flex items-center justify-between gap-3">
          <p class="hidden text-xs text-destructive" data-chat-error>Nie udało się wysłać wiadomości.</p>
          <button
            type="submit"
            class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-foreground disabled:cursor-not-allowed disabled:opacity-60"
            disabled
            data-chat-send
          >
            Wyślij
          </button>
        </div>
        <p class="text-xs leading-relaxed text-muted-foreground">{privacyNotice}</p>
      </form>
    </div>
  </div>
</div>

<script is:inline define:vars={{ locSlug, businessSlug }}>
(() => {
  const root = document.currentScript?.previousElementSibling;
  if (!root) return;
  const button = root.querySelector("[data-chat-open]");
  const panel = root.querySelector("[data-chat-panel]");
  const form = root.querySelector("[data-chat-form]");
  const input = root.querySelector("[data-chat-input]");
  const sendButton = root.querySelector("[data-chat-send]");
  const messages = root.querySelector("[data-chat-messages]");
  const error = root.querySelector("[data-chat-error]");
  if (!button || !panel || !form || !input || !sendButton || !messages) return;

  const storageKey = `chat-session:${locSlug}:${businessSlug}`;

  function setError(visible) {
    if (!error) return;
    error.classList.toggle("hidden", !visible);
  }

  function setReady(ready) {
    input.disabled = !ready;
    sendButton.disabled = !ready;
    sendButton.textContent = ready ? "Wyślij" : "Wysyłanie...";
  }

  function addMessage(role, content, pending = false) {
    const item = document.createElement("div");
    item.className =
      role === "visitor"
        ? "ml-auto max-w-[85%] rounded-lg bg-accent p-3 text-sm leading-relaxed text-accent-foreground"
        : "max-w-[85%] rounded-lg bg-muted p-3 text-sm leading-relaxed text-foreground";
    if (pending) item.classList.add("animate-pulse");
    item.textContent = content;
    messages.appendChild(item);
    item.scrollIntoView({ block: "nearest" });
    return item;
  }

  function replaceMessage(item, content) {
    item.classList.remove("animate-pulse");
    item.textContent = content;
    item.scrollIntoView({ block: "nearest" });
  }

  async function startChat() {
    const existingSessionId = sessionStorage.getItem(storageKey);
    const response = await fetch("/api/chat/start", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        locSlug,
        businessSlug,
        sessionId: existingSessionId,
      }),
    });
    if (!response.ok) return;
    const data = await response.json();
    if (data.sessionId) {
      sessionStorage.setItem(storageKey, data.sessionId);
      root.setAttribute("data-session-id", data.sessionId);
      setReady(true);
      return data.sessionId;
    }
    return null;
  }

  button.addEventListener("click", () => {
    panel.classList.remove("hidden");
    setError(false);
    startChat().catch(() => setError(true));
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const content = input.value.trim();
    if (!content) return;

    setError(false);
    setReady(false);
    addMessage("visitor", content);
    const pendingMessage = addMessage("assistant", "Asystent pisze...", true);
    input.value = "";

    try {
      const sessionId =
        root.getAttribute("data-session-id") ||
        sessionStorage.getItem(storageKey) ||
        (await startChat());
      if (!sessionId) throw new Error("missing chat session");

      const response = await fetch("/api/chat/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sessionId, content }),
      });
      if (!response.ok) throw new Error("chat message failed");

      const data = await response.json();
      if (!data.message?.content) throw new Error("empty chat response");
      replaceMessage(pendingMessage, data.message.content);
    } catch {
      setError(true);
      replaceMessage(
        pendingMessage,
        "Nie udało się uzyskać odpowiedzi. Spróbuj ponownie.",
      );
    } finally {
      setReady(true);
      input.focus();
    }
  });
})();
</script>
