---
import AuditmosFooterLink from './AuditmosFooterLink.astro';
import type { SellerChatEvidence, SellerRecentChat } from '../lib/seller-evidence';

interface Seller {
  id: number;
  name: string;
  token: string;
}

interface Lead {
  id: number;
  title: string;
  phone: string;
  address: string;
  category: string;
  rating: number | null;
  biz_slug: string;
  loc_slug: string;
  locality_name: string;
  site_status: 'pending' | 'in_progress' | 'done' | 'ineligible';
  status: string;
  comment: string | null;
  created_at: string;
}

interface Locality {
  slug: string;
  name: string;
  pow_name: string;
  woj_name: string;
  gmi_name: string;
}

interface Props {
  seller: Seller;
  leads: Lead[];
  localities: Locality[];
  currentStatus: string;
  currentLocality: string;
  currentSite: string;
  currentSort: string;
  token: string;
  page: number;
  totalPages: number;
  totalLeads: number;
  chatEvidence: SellerChatEvidence | null;
  recentChats: SellerRecentChat[];
}

const { seller, leads, localities, currentStatus, currentLocality, currentSite, currentSort, token, page, totalPages, totalLeads, chatEvidence, recentChats } = Astro.props;

const STATUS_CONFIG = {
  pending:     { color: 'bg-gray-200 text-gray-700',    label: 'Nowy' },
  called:      { color: 'bg-blue-100 text-blue-700',     label: 'Dzwoniono' },
  no_answer:   { color: 'bg-amber-100 text-amber-700',   label: 'Brak odpowiedzi' },
  interested:  { color: 'bg-green-100 text-green-700',   label: 'Zainteresowany' },
  rejected:    { color: 'bg-red-100 text-red-700',       label: 'Odmowa' },
  meeting_set: { color: 'bg-purple-100 text-purple-700', label: 'Spotkanie' },
  deal_closed: { color: 'bg-emerald-100 text-emerald-700', label: 'Zamknięte' },
} as const;

type StatusKey = keyof typeof STATUS_CONFIG;
const statuses: ('all' | StatusKey)[] = ['all', 'pending', 'called', 'no_answer', 'interested', 'rejected', 'meeting_set', 'deal_closed'];

const nameKey = (l: Locality) => `${l.name}|${l.pow_name}|${l.woj_name}`;
const nameCounts = new Map<string, number>();
const fullCounts = new Map<string, number>();
for (const loc of localities) {
  nameCounts.set(loc.name, (nameCounts.get(loc.name) ?? 0) + 1);
  const k = nameKey(loc);
  fullCounts.set(k, (fullCounts.get(k) ?? 0) + 1);
}
function locLabel(loc: Locality): string {
  if ((nameCounts.get(loc.name) ?? 0) <= 1) return loc.name;
  if (loc.pow_name === loc.name) return `${loc.name} (${loc.gmi_name})`;
  if ((fullCounts.get(nameKey(loc)) ?? 0) > 1) return `${loc.name} (gm. ${loc.gmi_name})`;
  return `${loc.name} (${loc.pow_name}, ${loc.woj_name})`;
}

const SITE_FILTER = [
  { value: 'all', label: 'Wszystkie' },
  { value: 'generated', label: 'Ze strona' },
  { value: 'none', label: 'Bez strony' },
] as const;

function emptyLabel(value: string | number | null | undefined): string | number {
  return value ?? 'brak';
}

function endReasonLabel(value: string | null): string {
  if (value === 'visitor') return 'gość';
  if (value === 'timeout') return 'timeout';
  return 'brak';
}

function roleLabel(value: 'visitor' | 'assistant'): string {
  return value === 'visitor' ? 'Gość' : 'Asystent';
}

function chatStatusLabel(value: 'active' | 'ended'): string {
  return value === 'active' ? 'aktywny' : 'zakończony';
}

function percentLabel(value: number): string {
  return `${(value * 100).toFixed(1)}%`;
}
---

<div class="max-w-7xl mx-auto px-4 py-6">
  <!-- Header -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Panel: {seller.name}</h1>
    <span class="text-sm text-gray-500">{totalLeads} leadow</span>
  </div>

  <!-- Filtry statusu -->
  <div class="flex flex-wrap gap-2 mb-4">
    {statuses.map((s) => (
      <a
        href={`/s/${token}?status=${s}&locality=${currentLocality}&site=${currentSite}&sort=${currentSort}`}
        class={`px-3 py-2 rounded-full text-sm font-medium transition
          ${currentStatus === s
            ? 'bg-indigo-600 text-white'
            : 'bg-white text-gray-600 border hover:bg-gray-50'}`}
      >
        {s === 'all' ? 'Wszystkie' : STATUS_CONFIG[s].label}
      </a>
    ))}
  </div>

  <!-- Filtr strony -->
  <div class="flex flex-wrap gap-2 mb-4">
    {SITE_FILTER.map((sf) => (
      <a
        href={`/s/${token}?status=${currentStatus}&locality=${currentLocality}&site=${sf.value}&sort=${currentSort}`}
        class={`px-3 py-2 rounded-full text-sm font-medium transition
          ${currentSite === sf.value
            ? 'bg-indigo-600 text-white'
            : 'bg-white text-gray-600 border hover:bg-gray-50'}`}
      >
        {sf.label}
      </a>
    ))}
  </div>

  <!-- Filtr miejscowosci + sortowanie -->
  <div class="flex gap-4 mb-6">
    <label for="locality-filter" class="sr-only">Filtruj miejscowość</label>
    <select
      id="locality-filter"
      class="border rounded-lg px-3 py-2 text-sm bg-white"
      data-token={token}
      data-status={currentStatus}
      data-site={currentSite}
      data-sort={currentSort}
    >
      <option value="">Wszystkie miejscowosci</option>
      {localities.map((loc) => (
        <option value={loc.slug} selected={currentLocality === loc.slug}>
          {locLabel(loc)}
        </option>
      ))}
    </select>

    <label for="sort-select" class="sr-only">Sortowanie</label>
    <select
      id="sort-select"
      class="border rounded-lg px-3 py-2 text-sm bg-white"
      data-token={token}
      data-status={currentStatus}
      data-site={currentSite}
      data-locality={currentLocality}
    >
      <option value="date" selected={currentSort === 'date'}>Wg daty</option>
      <option value="status" selected={currentSort === 'status'}>Wg statusu</option>
    </select>
  </div>

  <!-- Status config for client JS (single source of truth) -->
  <div id="status-config" data-config={JSON.stringify(STATUS_CONFIG)} class="hidden" />

  <section data-recent-chats class="bg-white rounded-lg shadow-sm border p-4 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Ostatnie chaty</h2>
      <span class="text-sm text-gray-500">{recentChats.length} / 20</span>
    </div>

    {recentChats.length === 0 ? (
      <p class="text-sm text-gray-500">Brak zapisanych chatów.</p>
    ) : (
      <div class="divide-y">
        {recentChats.map((chat) => (
          <a
            href={`/s/${token}?chat=${chat.id}`}
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 py-3 hover:bg-gray-50"
          >
            <span class="min-w-0">
              <span class="block font-medium text-gray-900 truncate">{chat.localitySlug}/{chat.businessSlug}</span>
              <span class="block text-xs text-gray-500 truncate">{chat.id}</span>
            </span>
            <span class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
              <span>{chat.startedAt}</span>
              <span class="rounded-full bg-gray-100 px-2 py-0.5 text-gray-700">{chatStatusLabel(chat.status)}</span>
              <span>{chat.messageCount ?? 0} wiadomości</span>
              {chat.hasComplaint && (
                <span class="rounded-full bg-red-50 px-2 py-0.5 text-red-700">reklamacja</span>
              )}
            </span>
          </a>
        ))}
      </div>
    )}
  </section>

  {chatEvidence && (
    <section data-chat-evidence class="bg-white rounded-lg shadow-sm border p-4 mb-6">
      <div class="flex flex-col gap-1 mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Transkrypt rozmowy</h2>
        <p class="text-sm text-gray-500">{chatEvidence.session.id}</p>
      </div>

      <dl class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mb-5 text-sm">
        <div>
          <dt class="text-gray-500">Strona</dt>
          <dd class="font-medium text-gray-900">{chatEvidence.session.localitySlug}/{chatEvidence.session.businessSlug}</dd>
        </div>
        <div>
          <dt class="text-gray-500">Rozpoczęto</dt>
          <dd class="font-medium text-gray-900">{chatEvidence.session.startedAt}</dd>
        </div>
        <div>
          <dt class="text-gray-500">Zakończono</dt>
          <dd class="font-medium text-gray-900">{emptyLabel(chatEvidence.session.endedAt)}</dd>
        </div>
        <div>
          <dt class="text-gray-500">Referrer</dt>
          <dd class="font-medium text-gray-900 break-words">{emptyLabel(chatEvidence.session.referrer)}</dd>
        </div>
        <div>
          <dt class="text-gray-500">User agent</dt>
          <dd class="font-medium text-gray-900 break-words">{emptyLabel(chatEvidence.session.userAgent)}</dd>
        </div>
        <div>
          <dt class="text-gray-500">Powód zakończenia</dt>
          <dd class="font-medium text-gray-900">{endReasonLabel(chatEvidence.session.endReason)}</dd>
        </div>
        <div>
          <dt class="text-gray-500">Wiadomości</dt>
          <dd class="font-medium text-gray-900">{chatEvidence.session.messageCount ?? chatEvidence.messages.length}</dd>
        </div>
        <div class="md:col-span-2">
          <dt class="text-gray-500">Podsumowanie intencji</dt>
          <dd class="font-medium text-gray-900">{emptyLabel(chatEvidence.session.intentSummary)}</dd>
        </div>
      </dl>

      <div class="border-t pt-4 mb-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Sygnały walidacyjne</h3>
        <dl class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
          <div>
            <dt class="text-gray-500">Wizyty strony</dt>
            <dd class="font-semibold text-gray-900">{chatEvidence.metrics.pageVisits}</dd>
          </div>
          <div>
            <dt class="text-gray-500">Starty chatu</dt>
            <dd class="font-semibold text-gray-900">{chatEvidence.metrics.chatStarts}</dd>
          </div>
          <div>
            <dt class="text-gray-500">Chat start rate</dt>
            <dd class="font-semibold text-gray-900">{percentLabel(chatEvidence.metrics.chatStartRate)}</dd>
          </div>
          <div>
            <dt class="text-gray-500">Wszystkie chaty</dt>
            <dd class="font-semibold text-gray-900">{chatEvidence.metrics.totalChats}</dd>
          </div>
          <div>
            <dt class="text-gray-500">Suma wiadomości</dt>
            <dd class="font-semibold text-gray-900">{chatEvidence.metrics.totalMessageCount}</dd>
          </div>
          <div>
            <dt class="text-gray-500">Średnio wiadomości</dt>
            <dd class="font-semibold text-gray-900">{chatEvidence.metrics.averageMessageCount.toFixed(1)}</dd>
          </div>
          <div>
            <dt class="text-gray-500">Intencje szczegółowe</dt>
            <dd class="font-semibold text-gray-900">{chatEvidence.metrics.specificIntentCount}</dd>
          </div>
          <div>
            <dt class="text-gray-500">Powtarzający się popyt</dt>
            <dd class="font-semibold text-gray-900">{chatEvidence.metrics.repeatedDemandCount}</dd>
          </div>
          <div>
            <dt class="text-gray-500">Reklamacje</dt>
            <dd class="font-semibold text-gray-900">{chatEvidence.metrics.complaintCount}</dd>
          </div>
        </dl>
      </div>

      {chatEvidence.messages.length === 0 ? (
        <p class="text-sm text-gray-500">Brak zapisanych wiadomości.</p>
      ) : (
        <div class="space-y-3">
          {chatEvidence.messages.map((message) => (
            <article class="border rounded-lg p-3 bg-gray-50">
              <div class="flex items-center justify-between gap-3 mb-1">
                <span class="text-xs font-semibold text-gray-600">{roleLabel(message.role)}</span>
                <time class="text-xs text-gray-400">{message.createdAt}</time>
              </div>
              <p class="text-sm text-gray-900 whitespace-pre-wrap">{message.content}</p>
            </article>
          ))}
        </div>
      )}
    </section>
  )}

  <!-- Lista leadow -->
  {leads.length === 0 ? (
    <p class="text-gray-500 text-center py-12">Brak leadow z tymi filtrami.</p>
  ) : (
    <div class="space-y-3">
      {leads.map((lead) => (
        <div
          class="bg-white rounded-lg shadow-sm border p-4"
          data-lead-id={lead.id}
          id={`lead-${lead.id}`}
        >
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <!-- Info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <h3 class="font-semibold text-gray-900 truncate">{lead.title}</h3>
                {lead.rating && (
                  <span class="text-xs text-yellow-600">{lead.rating}</span>
                )}
              </div>
              <p class="text-sm text-gray-500">{lead.address}</p>
              <div class="flex gap-3 mt-1 text-xs text-gray-400">
                <span>{lead.category}</span>
                <span>{lead.locality_name}</span>
                <span>{lead.created_at?.slice(0, 10)}</span>
              </div>
            </div>

            <!-- Akcje -->
            <div class="flex items-center gap-2 flex-shrink-0">
              <a
                href={`tel:${lead.phone}`}
                class="inline-flex items-center px-3 py-1.5 bg-green-600 text-white text-sm rounded-l-lg hover:bg-green-700"
              >
                {lead.phone}
              </a><button
                class="copy-phone px-2 py-1.5 bg-green-700 text-white text-sm rounded-r-lg hover:bg-green-800"
                data-phone={lead.phone}
                title="Kopiuj numer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z"/><path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z"/></svg>
              </button>
              {lead.site_status === 'done' ? (
                <a
                  href={`/${lead.loc_slug}/${lead.biz_slug}`}
                  target="_blank"
                  class="px-3 py-1.5 bg-indigo-50 text-indigo-600 text-sm rounded-lg hover:bg-indigo-100"
                >
                  Strona
                </a>
              ) : (
                <span class="px-3 py-1.5 bg-gray-100 text-gray-400 text-sm rounded-lg">
                  Brak strony
                </span>
              )}
            </div>
          </div>

          <!-- Status + komentarz -->
          <div class="flex flex-col sm:flex-row gap-3 mt-3 pt-3 border-t">
            <select
              class="status-select border rounded px-2 py-1 text-sm"
              data-lead-id={lead.id}
              data-token={token}
            >
              {Object.entries(STATUS_CONFIG).map(([val, cfg]) => (
                <option value={val} selected={lead.status === val}>
                  {cfg.label}
                </option>
              ))}
            </select>

            <div class="flex-1 flex gap-2">
              <input
                type="text"
                class="comment-input flex-1 border rounded px-2 py-1 text-sm"
                placeholder="Komentarz..."
                value={lead.comment ?? ''}
                data-lead-id={lead.id}
                data-token={token}
              />
              <button
                class="save-comment px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded hover:bg-gray-200"
                data-lead-id={lead.id}
              >
                Zapisz
              </button>
            </div>

            <span
              class={`status-badge inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${STATUS_CONFIG[lead.status as StatusKey]?.color ?? ''}`}
              data-lead-id={lead.id}
            >
              {STATUS_CONFIG[lead.status as StatusKey]?.label ?? lead.status}
            </span>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- Paginacja -->
  {totalPages > 1 && (
    <div class="flex justify-center gap-2 mt-6">
      {page > 1 && (
        <a
          href={`/s/${token}?status=${currentStatus}&locality=${currentLocality}&site=${currentSite}&sort=${currentSort}&page=${page - 1}`}
          class="px-3 py-1 rounded border text-sm hover:bg-gray-50"
        >Poprzednia</a>
      )}
      <span class="px-3 py-1 text-sm text-gray-500">{page} / {totalPages}</span>
      {page < totalPages && (
        <a
          href={`/s/${token}?status=${currentStatus}&locality=${currentLocality}&site=${currentSite}&sort=${currentSort}&page=${page + 1}`}
          class="px-3 py-1 rounded border text-sm hover:bg-gray-50"
        >Nastepna</a>
      )}
    </div>
  )}

  <footer class="mt-10 border-t pt-6 text-center text-gray-400">
    <AuditmosFooterLink linkClass="hover:text-gray-600" />
  </footer>
</div>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
</style>

<script>
  document.getElementById('locality-filter')?.addEventListener('change', (e) => {
    const el = e.target as HTMLSelectElement;
    const token = el.dataset.token;
    const status = el.dataset.status;
    const site = el.dataset.site;
    const sort = el.dataset.sort;
    window.location.href = `/s/${token}?status=${status}&locality=${el.value}&site=${site}&sort=${sort}`;
  });

  document.getElementById('sort-select')?.addEventListener('change', (e) => {
    const el = e.target as HTMLSelectElement;
    const token = el.dataset.token;
    const status = el.dataset.status;
    const site = el.dataset.site;
    const locality = el.dataset.locality;
    window.location.href = `/s/${token}?status=${status}&locality=${locality}&site=${site}&sort=${el.value}`;
  });

  document.querySelectorAll('.copy-phone').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement;
      await navigator.clipboard.writeText(el.dataset.phone ?? '');
      el.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>';
      setTimeout(() => {
        el.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z"/><path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z"/></svg>';
      }, 1500);
    });
  });

  document.querySelectorAll('.status-select').forEach((select) => {
    select.addEventListener('change', async (e) => {
      const el = e.target as HTMLSelectElement;
      const leadId = el.dataset.leadId;
      const token = el.dataset.token;

      const commentInput = document.querySelector(
        `.comment-input[data-lead-id="${leadId}"]`
      ) as HTMLInputElement;

      const res = await fetch(`/api/leads/${leadId}?token=${token}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: el.value,
          comment: commentInput?.value || undefined,
        }),
      });

      if (res.ok) {
        const badge = document.querySelector(
          `.status-badge[data-lead-id="${leadId}"]`
        ) as HTMLElement;
        if (badge) {
          const cfg = JSON.parse(document.getElementById('status-config')?.dataset.config ?? '{}');
          const c = cfg[el.value] ?? { color: '', label: el.value };
          badge.className = `status-badge inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${c.color}`;
          badge.textContent = c.label;
        }
      } else {
        alert('Blad zapisu statusu');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.save-comment').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement;
      const leadId = el.dataset.leadId;

      const commentInput = document.querySelector(
        `.comment-input[data-lead-id="${leadId}"]`
      ) as HTMLInputElement;
      const statusSelect = document.querySelector(
        `.status-select[data-lead-id="${leadId}"]`
      ) as unknown as HTMLSelectElement | null;
      const token = statusSelect?.dataset.token;

      const res = await fetch(`/api/leads/${leadId}?token=${token}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          comment: commentInput?.value,
        }),
      });

      if (res.ok) {
        el.textContent = 'Zapisano!';
        setTimeout(() => (el.textContent = 'Zapisz'), 1500);
      } else {
        alert('Blad zapisu komentarza');
      }
    });
  });
</script>
