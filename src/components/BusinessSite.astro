---
import type { SiteData } from '../types/site';
import { resolveTheme, getPaletteById, paletteToCSS, isLayoutVariant, isStyleVariant } from '../lib/themes';
import { buildLocalBusinessLd, buildBreadcrumbLd, safeJsonScript, type BizData } from '../lib/structured-data';
import { buildPublicBusinessPageModel } from '../lib/public-page';
import { canonicalFor, robotsForBusiness } from '../lib/indexability';
import CenteredLayout from './layouts/CenteredLayout.astro';
import SplitLayout from './layouts/SplitLayout.astro';
import MinimalLayout from './layouts/MinimalLayout.astro';
import '../styles/base.css';

interface RelatedBusiness {
  title: string;
  slug: string;
  category: string;
}
interface Props {
  site: SiteData;
  biz: BizData | null;
  slug: string;
  locSlug: string;
  locName: string;
  locLabel: string;
  relatedBusinesses: RelatedBusiness[];
  isIndexable?: boolean;
}

const { site, biz, slug, locSlug, locName, locLabel, relatedBusinesses, isIndexable = true } = Astro.props;

const category = biz?.category ?? '';
const resolved = resolveTheme(slug, category);
const palette = site.theme ? (getPaletteById(site.theme) ?? resolved.palette) : resolved.palette;
const layout = isLayoutVariant(site.layout) ? site.layout : resolved.layout;
const style = isStyleVariant(site.style) ? site.style : resolved.style;
const cssVars = paletteToCSS(palette);
const page = buildPublicBusinessPageModel(site, biz);

const canonicalUrl = canonicalFor(Astro.url.pathname);
const robots = robotsForBusiness(isIndexable);
const jsonLd = biz ? safeJsonScript(buildLocalBusinessLd(biz, canonicalUrl)) : null;

const breadcrumbLd = safeJsonScript(buildBreadcrumbLd(page.seo.title, locSlug, locName));

const fontLink = style === 'elegant'
  ? '<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">'
  : '<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">';
---

<!DOCTYPE html>
<html lang="pl" dir="ltr" data-style={style}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    (function(){
      var s=localStorage.getItem('theme');
      if(s==='dark'||(s!=='light'&&matchMedia('(prefers-color-scheme:dark)').matches))
        document.documentElement.classList.add('dark');
    })();
  </script>
  <title>{page.seo.title}</title>
  <meta name="description" content={page.seo.description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:title" content={page.seo.title} />
  <meta property="og:description" content={page.seo.description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="pl_PL" />
  <meta name="twitter:card" content="summary" />

  <Fragment set:html={fontLink} />
  <style set:html={cssVars} />

  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>

<body class="bg-background text-foreground font-sans antialiased">
<nav aria-label="breadcrumb" class="px-4 py-3 text-sm text-muted-foreground max-w-5xl mx-auto">
  <ol class="flex items-center gap-1 flex-wrap">
    <li><a href="/" class="hover:underline hover:text-foreground transition-colors">Strona główna</a></li>
    <li class="before:content-['/'] before:mx-1"><a href={`/${locSlug}`} class="hover:underline hover:text-foreground transition-colors">{locName}</a></li>
    <li class="before:content-['/'] before:mx-1 text-foreground/60 truncate max-w-[200px] sm:max-w-none">{page.seo.title}</li>
  </ol>
</nav>
<main>
{layout === 'centered' ? <CenteredLayout site={site} page={page} category={category} slug={slug} locSlug={locSlug} locName={locName} locLabel={locLabel} relatedBusinesses={relatedBusinesses} />
: layout === 'split' ? <SplitLayout site={site} page={page} category={category} slug={slug} locSlug={locSlug} locName={locName} locLabel={locLabel} relatedBusinesses={relatedBusinesses} />
: <MinimalLayout site={site} page={page} category={category} slug={slug} locSlug={locSlug} locName={locName} locLabel={locLabel} relatedBusinesses={relatedBusinesses} />}
</main>

<div id="theme-toggle" class="fixed bottom-4 right-4 z-50 flex items-center gap-1 rounded-full bg-card text-card-foreground shadow-lg ring-1 ring-border p-1">
  <button data-set="light" aria-label="Jasny motyw" class="theme-btn rounded-full p-2 transition-colors hover:bg-muted">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
  </button>
  <button data-set="system" aria-label="Systemowy motyw" class="theme-btn rounded-full p-2 transition-colors hover:bg-muted">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
  </button>
  <button data-set="dark" aria-label="Ciemny motyw" class="theme-btn rounded-full p-2 transition-colors hover:bg-muted">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>
</div>

<script is:inline>
(function(){
  var root = document.documentElement;
  var btns = document.querySelectorAll('#theme-toggle .theme-btn');
  var stored = localStorage.getItem('theme') || 'system';

  function apply(mode) {
    if (mode === 'dark') {
      root.classList.add('dark');
    } else if (mode === 'light') {
      root.classList.remove('dark');
    } else {
      if (matchMedia('(prefers-color-scheme:dark)').matches) {
        root.classList.add('dark');
      } else {
        root.classList.remove('dark');
      }
    }
    btns.forEach(function(b) {
      b.classList.toggle('bg-muted', b.dataset.set === mode);
    });
  }

  btns.forEach(function(b) {
    b.addEventListener('click', function() {
      var mode = b.dataset.set;
      localStorage.setItem('theme', mode);
      apply(mode);
    });
  });

  matchMedia('(prefers-color-scheme:dark)').addEventListener('change', function() {
    if ((localStorage.getItem('theme') || 'system') === 'system') apply('system');
  });

  apply(stored);
})();
</script>
</body>
</html>
