---
import '../../styles/base.css';
import { env } from 'cloudflare:workers';
import SellerPanel from '../../components/SellerPanel.astro';
import { loadSellerPanelRouteData } from '../../lib/seller-panel-data';

const { token } = Astro.params;
if (!token) return new Response(null, { status: 404 });

Astro.response.headers.set('Cache-Control', 'private, no-store');

const url = new URL(Astro.request.url);
const data = await loadSellerPanelRouteData(env.leadgen as D1Database, token, url);
if (!data) return new Response(null, { status: 404 });
---

<!DOCTYPE html>
<html lang="pl" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>Panel - {data.seller.name}</title>
</head>
<body class="bg-gray-50 min-h-screen">
  <SellerPanel
    seller={data.seller}
    leads={data.leadPage.leads}
    localities={data.localities}
    currentStatus={data.currentStatus}
    currentLocality={data.currentLocality}
    currentSite={data.currentSite}
    currentSort={data.currentSort}
    token={token}
    page={data.leadPage.page}
    totalPages={data.leadPage.totalPages}
    totalLeads={data.leadPage.total}
    chatEvidence={data.chatEvidence}
    recentChats={data.recentChats}
  />
</body>
</html>
