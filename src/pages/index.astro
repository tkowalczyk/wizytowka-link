---
import '../styles/base.css';
import { env } from 'cloudflare:workers';
import AuditmosFooterLink from '../components/AuditmosFooterLink.astro';
import { safeJsonScript } from '../lib/structured-data';
import { canonicalFor, SOCIAL_IMAGE } from '../lib/indexability';

const title = "wizytowka.link — wizytówki z asystentem AI"
const description =
  "Automatycznie generowane, niezależne wizytówki dla polskich firm z mapą, lokalnym kontekstem i asystentem AI zamiast publicznego telefonu."
const url = canonicalFor("/")
const turnstileSiteKey = env.TURNSTILE_SITE_KEY ?? ""
---

<html lang="pl" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="wizytowka.link" />
    <meta property="og:image" content={SOCIAL_IMAGE.url} />
    <meta property="og:image:width" content={SOCIAL_IMAGE.width} />
    <meta property="og:image:height" content={SOCIAL_IMAGE.height} />
    <meta property="og:image:alt" content={SOCIAL_IMAGE.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SOCIAL_IMAGE.url} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE.alt} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload={`
      // @ts-expect-error - astro check false positive on 'media' inside inline handler
      this.media='all'
    `} />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" /></noscript>

    <script
      is:inline
      type="application/ld+json"
      set:html={safeJsonScript({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            name: "wizytowka.link",
            url,
            description,
            inLanguage: "pl-PL",
          },
          {
            "@type": "Organization",
            name: "wizytowka.link",
            url,
            description:
              "Platforma automatycznie generowanych, niezależnych wizytówek dla polskich firm z asystentem AI.",
          },
          {
            "@type": "SoftwareApplication",
            name: "wizytowka.link",
            applicationCategory: "BusinessApplication",
            operatingSystem: "Web",
            offers: { "@type": "Offer", price: "0", priceCurrency: "PLN" },
            description,
          },
        ],
      })}
    />

    <style>
      html {
        font-family: "Inter", system-ui, sans-serif;
        scroll-behavior: smooth;
      }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
      :target, :focus { scroll-margin-top: 5rem; }
    </style>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded focus:shadow">Przejdź do treści</a>
    <!-- Nav -->
    <header
      id="navbar"
      class="fixed top-0 left-0 right-0 z-50 transition-all duration-150"
    >
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="#" class="text-xl font-extrabold">
          <span class="text-blue-600">wizytowka</span><span class="text-gray-800">.link</span>
        </a>
        <div class="hidden items-center gap-6 md:flex">
          <a href="#jak-to-dziala" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors">Jak to działa</a>
          <a href="#funkcje" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors">Funkcje</a>
          <a href="#faq" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors">FAQ</a>
          <a
            href="#kontakt"
            class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-colors"
          >
            Sprawdź swoją firmę
          </a>
        </div>
        <button
          id="menu-toggle"
          class="md:hidden p-2 text-gray-600"
          aria-label="Otwórz menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </nav>
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white/95 backdrop-blur px-4 pb-4">
        <a href="#jak-to-dziala" class="block py-2 text-sm font-medium text-gray-600">Jak to działa</a>
        <a href="#funkcje" class="block py-2 text-sm font-medium text-gray-600">Funkcje</a>
        <a href="#faq" class="block py-2 text-sm font-medium text-gray-600">FAQ</a>
        <a
          href="#kontakt"
          class="mt-2 block rounded-lg bg-blue-600 px-4 py-2 text-center text-sm font-semibold text-white"
        >
          Sprawdź swoją firmę
        </a>
      </div>
    </header>

    <main id="main-content">
      <!-- Hero -->
      <section class="relative overflow-hidden border-b border-gray-100 bg-slate-50 pt-32 pb-20 md:pt-40 md:pb-28">
        <div class="relative mx-auto max-w-4xl px-4 text-center">
          <h1 class="text-balance text-4xl font-extrabold leading-tight text-gray-900 md:text-6xl md:leading-tight">
            Strony internetowe<br />
            z pomocnym asystentem
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-pretty text-lg text-gray-600 md:text-xl">
            Automatycznie tworzymy publiczne strony dla lokalnych firm — z mapą, godzinami otwarcia, opisem usług i&nbsp;przyciskiem „Zapytaj asystenta” zamiast wystawiania telefonu na stronie.
          </p>
          <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
            <a
              href="#kontakt"
              class="rounded-lg bg-blue-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-blue-600/20 hover:bg-blue-700 transition-colors"
            >
              Sprawdź swoją firmę
            </a>
            <a
              href="#jak-to-dziala"
              class="rounded-lg border border-gray-200 bg-white px-8 py-3.5 text-base font-semibold text-gray-700 shadow-sm hover:border-gray-300 hover:bg-gray-50 transition-colors"
            >
              Jak to działa?
            </a>
          </div>
        </div>
      </section>

      <!-- Problem -->
      <section class="py-20 bg-white">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="text-balance text-center text-3xl font-bold md:text-4xl">
            Dlaczego zmieniliśmy model kontaktu?
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-center text-pretty text-gray-600">
            Wizytówka ma pomóc klientowi zrozumieć miejsce i&nbsp;zadać pytanie, ale nie powinna udawać oficjalnej strony firmy.
          </p>
          <div class="mt-14 grid gap-8 md:grid-cols-3">
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-8 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-red-100 text-2xl font-bold text-red-600">
                1
              </div>
              <h3 class="text-lg font-semibold">Strona bez podszywania się</h3>
              <p class="mt-2 text-sm text-gray-600">
                Wizytówka jasno działa jako niezależna strona informacyjna, a asystent mówi, że nie reprezentuje bezpośrednio firmy.
              </p>
            </div>
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-8 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-amber-100 text-2xl font-bold text-amber-600">
                2
              </div>
              <h3 class="text-lg font-semibold">Pytania zostają na stronie</h3>
              <p class="mt-2 text-sm text-gray-600">
                Zamiast odsyłać od razu do telefonu lub e-maila, strona pozwala rozpocząć rozmowę z&nbsp;asystentem.
              </p>
            </div>
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-8 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-green-100 text-2xl font-bold text-green-600">
                3
              </div>
              <h3 class="text-lg font-semibold">Widać realne zainteresowanie</h3>
              <p class="mt-2 text-sm text-gray-600">
                Transkrypty i&nbsp;podsumowania intencji pokazują, o&nbsp;co odwiedzający faktycznie pytali.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section id="jak-to-dziala" class="py-20 bg-gray-50">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="text-balance text-center text-3xl font-bold md:text-4xl">
            Jak to działa?
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-center text-pretty text-gray-600">
            Strona powstaje automatycznie, ale publiczna komunikacja pozostaje ostrożna i&nbsp;przejrzysta.
          </p>
          <div class="mt-14 grid gap-10 md:grid-cols-3">
            <div class="text-center">
              <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-600 text-2xl font-bold text-white shadow-lg shadow-blue-600/20">
                1
              </div>
              <h3 class="text-lg font-semibold">Znajdujemy lokalną firmę</h3>
              <p class="mt-2 text-sm text-gray-600">
                Automatycznie wyszukujemy lokalne firmy bez strony www i&nbsp;zbieramy publiczny kontekst: nazwę, kategorię, adres, godziny i&nbsp;mapę.
              </p>
            </div>
            <div class="text-center">
              <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-600 text-2xl font-bold text-white shadow-lg shadow-blue-600/20">
                2
              </div>
              <h3 class="text-lg font-semibold">Generujemy stronę</h3>
              <p class="mt-2 text-sm text-gray-600">
                AI tworzy unikalną stronę z&nbsp;opisem działalności, usługami, mapą, SEO i&nbsp;CTA „Zapytaj asystenta”.
              </p>
            </div>
            <div class="text-center">
              <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-600 text-2xl font-bold text-white shadow-lg shadow-blue-600/20">
                3
              </div>
              <h3 class="text-lg font-semibold">Zbieramy pytania</h3>
              <p class="mt-2 text-sm text-gray-600">
                Asystent odpowiada z&nbsp;danych strony, nie podaje bezpośrednich kontaktów i&nbsp;zapisuje rozmowę jako sygnał popytu.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Features -->
      <section id="funkcje" class="py-20 bg-white">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="text-balance text-center text-3xl font-bold md:text-4xl">
            Co otrzymujesz?
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-center text-pretty text-gray-600">
            Każda wizytówka pokazuje najważniejszy kontekst i&nbsp;pozwala bezpiecznie sprawdzić zainteresowanie klientów.
          </p>
          <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {[
              { icon: "🔍", title: "Optymalizacja SEO", desc: "Meta tagi, schema.org, semantyczny HTML — Twoja firma wyżej w&nbsp;wynikach Google." },
              { icon: "📱", title: "Mobile-first", desc: "Responsywny design dopasowany do każdego urządzenia — telefon, tablet, komputer." },
              { icon: "🎨", title: "Unikalne motywy", desc: "24 profesjonalne szablony — każda wizytówka wygląda inaczej." },
              { icon: "📍", title: "Mapa Google", desc: "Interaktywna mapa z&nbsp;lokalizacją firmy — klienci od razu wiedzą, gdzie Cię znaleźć." },
              { icon: "🤖", title: "Asystent AI", desc: "Polski chat odpowiada z&nbsp;danych wizytówki i&nbsp;nie podaje telefonu, e-maila ani linków kontaktowych." },
              { icon: "📊", title: "Dowody zainteresowania", desc: "Starty chatu, transkrypty, intencje i&nbsp;reklamacje trafiają do prywatnego panelu operatora." },
            ].map(({ icon, title, desc }) => (
              <article class="rounded-lg border border-gray-100 p-6 hover:border-blue-100 hover:bg-blue-50/30 transition-colors">
                <div class="mb-3 text-3xl">{icon}</div>
                <h3 class="text-base font-semibold">{title}</h3>
                <p class="mt-2 text-sm text-gray-600" set:html={desc} />
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Social proof -->
      <section class="py-20 bg-gray-50">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="text-balance text-center text-3xl font-bold md:text-4xl">
            Platforma w&nbsp;liczbach
          </h2>
          <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {[
              { value: "95 000+", label: "Polskich miejscowości" },
              { value: "24", label: "Motywy graficzne" },
              { value: "CDN", label: "Globalne hostowanie" },
              { value: "AI", label: "Generowanie i asystent" },
            ].map(({ value, label }) => (
              <div class="rounded-lg bg-white border border-gray-100 p-8 text-center shadow-sm">
                <div class="text-3xl font-extrabold text-blue-600">{value}</div>
                <div class="mt-2 text-sm font-medium text-gray-600">{label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="py-20 bg-white">
        <div class="mx-auto max-w-3xl px-4">
          <h2 class="text-balance text-center text-3xl font-bold md:text-4xl">
            Najczęstsze pytania
          </h2>
          <div class="mt-12 divide-y divide-gray-200">
            {[
              {
                q: "Czy to oficjalna strona firmy?",
                a: "Nie. Wizytówka jest niezależną stroną informacyjną. Asystent AI również informuje, że nie reprezentuje bezpośrednio danego miejsca.",
              },
              {
                q: "Czy pokazujecie numer telefonu lub e-mail?",
                a: "Nie pokazujemy bezpośredniego telefonu, e-maila ani linku kontaktowego na publicznej wizytówce. Zachowujemy kontekst taki jak adres, godziny otwarcia i mapa.",
              },
              {
                q: "Co robi asystent AI?",
                a: "Odpowiada po polsku na pytania o miejsce, korzystając z danych wizytówki i bazy. Jeśli czegoś nie wie albo sprawa wymaga człowieka, mówi to wprost.",
              },
              {
                q: "Skąd bierzecie dane mojej firmy?",
                a: "Korzystamy z publicznych źródeł, takich jak mapy i rejestry firm. Właściciel może poprosić o korektę lub usunięcie wizytówki.",
              },
              {
                q: "Czy rozmowy są zapisywane?",
                a: "Tak, rozmowy z asystentem mogą być zapisywane, aby ocenić zainteresowanie wizytówką i poprawiać jakość odpowiedzi. Informujemy o tym przy polu chatu.",
              },
            ].map(({ q, a }) => (
              <details class="group" data-faq>
                <summary class="flex cursor-pointer items-center justify-between py-5 text-left text-base font-semibold text-gray-900">
                  {q}
                  <svg
                    class="ml-4 h-5 w-5 shrink-0 text-gray-400 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="pb-5 text-sm text-gray-600">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section id="kontakt" class="py-20 bg-blue-700">
        <div class="mx-auto max-w-3xl px-4 text-center">
          <h2 class="text-balance text-3xl font-bold text-white md:text-4xl">
            Sprawdź, czy Twoja firma ma już wizytówkę
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-pretty text-blue-100">
            Jeśli jesteś właścicielem firmy, zostaw numer telefonu — oddzwonimy i pomożemy zweryfikować lub uporządkować wizytówkę.
          </p>
          <form id="contact-form" class="mx-auto mt-10 flex max-w-lg flex-col gap-3 sm:flex-row">
            <label for="phone-input" class="sr-only">Numer telefonu</label>
            <input
              type="tel"
              id="phone-input"
              placeholder="+48 600 123 456"
              required
              class="flex-1 rounded-lg border-0 px-5 py-3.5 text-base text-gray-900 shadow-lg placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-white/50"
            />
            <button
              type="submit"
              id="contact-btn"
              class="rounded-lg bg-white px-6 py-3.5 text-base font-semibold text-blue-600 shadow-lg hover:bg-blue-50 transition-colors disabled:opacity-50"
            >
              Wyślij
            </button>
          </form>
          <div class="cf-turnstile mx-auto mt-4" data-sitekey={turnstileSiteKey} data-callback="onTurnstile" data-theme="dark"></div>
          <p id="contact-msg" class="mt-4 text-sm text-blue-200 hidden"></p>
          <p class="mt-2 text-sm text-blue-200">Bezpłatnie. Bez rejestracji.</p>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-100 bg-gray-50 py-10">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 text-center text-sm text-gray-500 sm:flex-row sm:justify-between sm:text-left">
        <div>&copy; {new Date().getFullYear()} wizytowka.link</div>
        <AuditmosFooterLink linkClass="hover:text-gray-700" />
        <div class="flex gap-6">
          <a href="/regulamin" class="hover:text-gray-700 transition-colors">Regulamin</a>
          <a href="/polityka-prywatnosci" class="hover:text-gray-700 transition-colors">Polityka prywatności</a>
        </div>
      </div>
    </footer>

    <script>
      // Navbar bg on scroll
      const nav = document.getElementById("navbar");
      if (!nav) throw new Error("Missing navbar");
      const update = () => {
        if (window.scrollY > 20) {
          nav.classList.add("bg-white/95", "backdrop-blur", "shadow-sm");
        } else {
          nav.classList.remove("bg-white/95", "backdrop-blur", "shadow-sm");
        }
      };
      window.addEventListener("scroll", update, { passive: true });
      update();

      // Mobile menu
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      if (!toggle || !menu) throw new Error("Missing mobile menu controls");
      toggle.addEventListener("click", () => {
        const open = !menu.classList.contains("hidden");
        menu.classList.toggle("hidden");
        toggle.setAttribute("aria-expanded", String(!open));
      });
      menu.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => menu.classList.add("hidden"))
      );

      // FAQ: close others on open
      document.querySelectorAll("[data-faq]").forEach((el) => {
        el.addEventListener("toggle", () => {
          if ((el as HTMLDetailsElement).open) {
            document.querySelectorAll("[data-faq]").forEach((other) => {
              if (other !== el) (other as HTMLDetailsElement).open = false;
            });
          }
        });
      });

      // Contact form
      let turnstileToken = "";
      const pageWindow = window as Window & {
        onTurnstile?: (token: string) => void;
        turnstile?: { reset?: () => void };
      };
      pageWindow.onTurnstile = (token: string) => { turnstileToken = token; };

      const phoneRe = /^\+?48?\s?\d{3}\s?\d{3}\s?\d{3}$|^\d{9}$/;
      const form = document.getElementById("contact-form") as HTMLFormElement;
      const phoneInput = document.getElementById("phone-input") as HTMLInputElement;
      const btn = document.getElementById("contact-btn") as HTMLButtonElement;
      const msg = document.getElementById("contact-msg") as HTMLParagraphElement;

      function showMsg(text: string, ok: boolean) {
        msg.textContent = text;
        msg.className = `mt-4 text-sm ${ok ? "text-green-200" : "text-red-200"}`;
        msg.classList.remove("hidden");
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const phone = phoneInput.value.trim();

        if (!phoneRe.test(phone)) {
          showMsg("Podaj prawidłowy numer (9 cyfr lub +48...)", false);
          return;
        }
        if (!turnstileToken) {
          showMsg("Poczekaj na weryfikację...", false);
          return;
        }

        btn.disabled = true;
        btn.textContent = "Wysyłanie...";
        msg.classList.add("hidden");

        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ phone, token: turnstileToken }),
          });
          const data = (await res.json()) as { ok?: boolean; error?: string };
          if (data.ok) {
            showMsg("Dziękujemy! Oddzwonimy wkrótce.", true);
            phoneInput.value = "";
          } else {
            showMsg(data.error || "Wystąpił błąd", false);
          }
        } catch {
          showMsg("Błąd połączenia", false);
        } finally {
          btn.disabled = false;
          btn.textContent = "Wyślij";
          turnstileToken = "";
          pageWindow.turnstile?.reset?.();
        }
      });
    </script>
  </body>
</html>
