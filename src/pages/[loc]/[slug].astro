---
import BusinessSite from '../../components/BusinessSite.astro';
import { getSite } from '../../lib/site-store';
import { formatLocalityLabel } from '../../lib/locality-label';

const { loc, slug } = Astro.params;

if (!loc || !slug) return new Response(null, { status: 404 });

const r2 = Astro.locals.runtime.env.sites as R2Bucket;
const db = Astro.locals.runtime.env.leadgen as D1Database;

const isDraft = Astro.url.searchParams.get('draft') === '1';
const site = await getSite(r2, isDraft ? 'draft' : 'live', loc, slug);

if (!site) return new Response('Not Found', { status: 404 });

const biz = await db.prepare(`
  SELECT b.title, b.phone, b.address, b.category, b.gps_lat, b.gps_lng, b.rating, b.reviews_count
  FROM businesses b
  JOIN localities l ON b.locality_id = l.id
  WHERE l.slug = ? AND b.slug = ?
`).bind(loc, slug).first<{
  title: string; phone: string; address: string; category: string;
  gps_lat: number; gps_lng: number; rating: number | null; reviews_count: number | null;
}>();

const locRow = await db.prepare(`SELECT name, gmi_name, pow_name FROM localities WHERE slug = ?`)
  .bind(loc).first<{ name: string; gmi_name: string | null; pow_name: string | null }>();

const locLabel = locRow
  ? formatLocalityLabel({
      name: locRow.name,
      gmi_name: locRow.gmi_name ?? '',
      pow_name: locRow.pow_name ?? '',
    })
  : loc;

const { results: relatedBusinesses } = await db.prepare(`
  SELECT b.title, b.slug, b.category
  FROM businesses b
  JOIN localities l ON b.locality_id = l.id
  WHERE l.slug = ? AND b.slug != ? AND b.site_status = 'done'
  ORDER BY b.rating DESC
  LIMIT 6
`).bind(loc, slug).all<{ title: string; slug: string; category: string }>();

if (isDraft) {
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=86400, s-maxage=604800');
}
---

{isDraft && (
  <div style="background:#f59e0b;color:#000;text-align:center;padding:12px;font-weight:bold;position:fixed;top:0;left:0;right:0;z-index:9999;">
    PODGLAD — ta wersja nie jest jeszcze opublikowana
  </div>
)}

<BusinessSite site={site} biz={biz} slug={slug} locSlug={loc} locName={locRow?.name ?? loc} locLabel={locLabel} relatedBusinesses={relatedBusinesses ?? []} />
