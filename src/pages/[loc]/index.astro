---
import "../../styles/base.css";
import { findLocalityCategories } from "../../lib/category";
import type { LocalityRow } from "../../types/business";

const { loc } = Astro.params;

if (!loc) return new Response(null, { status: 404 });

const db = Astro.locals.runtime.env.leadgen as D1Database;

const locality = await db
	.prepare("SELECT * FROM localities WHERE slug = ?")
	.bind(loc)
	.first<LocalityRow>();

if (!locality) return new Response("Not Found", { status: 404 });

const categories = await findLocalityCategories(db, loc);

const url = `https://wizytowka.link/${loc}`;
const _title = `Firmy w ${locality.name} — wizytowka.link`;
const _description = `Katalog firm i usług w ${locality.name}. Znajdź lokalne firmy, rzemieślników i usługodawców.`;

const _breadcrumbLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Strona główna",
			item: "https://wizytowka.link/",
		},
		{ "@type": "ListItem", position: 2, name: locality.name, item: url },
	],
});

Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=3600, s-maxage=86400",
);
---

<html lang="pl" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script is:inline type="application/ld+json" set:html={breadcrumbLd} />

    <style>
      html {
        font-family: "Inter", system-ui, sans-serif;
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <!-- Header -->
    <header class="border-b border-gray-100 bg-white">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/" class="text-xl font-extrabold tracking-tight">
          <span class="text-blue-600">wizytowka</span><span class="text-gray-800">.link</span>
        </a>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-gray-500">
        <ol class="flex items-center gap-1.5">
          <li>
            <a href="/" class="hover:text-blue-600 transition-colors">Strona główna</a>
          </li>
          <li class="text-gray-300">/</li>
          <li class="font-medium text-gray-900">{locality.name}</li>
        </ol>
      </nav>

      <!-- Heading -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
          Firmy w {locality.name}
        </h1>
        {locality.pow_name && (
          <p class="mt-2 text-gray-500">
            {[locality.pow_name, locality.woj_name].filter(Boolean).join(', ')}
          </p>
        )}
        <p class="mt-1 text-sm text-gray-400">
          {categories.length === 0
            ? 'Brak firm z wygenerowanymi wizytówkami w tej miejscowości.'
            : `${categories.reduce((s, c) => s + c.count, 0)} firm w ${categories.length} ${categories.length === 1 ? 'kategorii' : categories.length < 5 ? 'kategoriach' : 'kategoriach'}`}
        </p>
      </div>

      {categories.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((cat) => (
            <a
              href={`/${loc}/kategoria/${cat.slug}`}
              class="group rounded-xl border border-gray-100 bg-white p-5 shadow-sm transition-all hover:border-blue-200 hover:shadow-md"
            >
              <div class="flex items-center justify-between gap-2">
                <h2 class="text-base font-semibold text-gray-900 group-hover:text-blue-600 transition-colors leading-snug capitalize">
                  {cat.categoryName}
                </h2>
                <span class="inline-flex shrink-0 items-center rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700">
                  {cat.count} {cat.count === 1 ? 'firma' : cat.count < 5 ? 'firmy' : 'firm'}
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-gray-100 bg-gray-50 px-6 py-16 text-center">
          <svg class="mx-auto mb-4 h-12 w-12 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 7.5h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
          </svg>
          <p class="text-gray-500">Nie znaleziono firm z wygenerowanymi wizytówkami w tej miejscowości.</p>
          <p class="mt-2 text-sm text-gray-400">Nowe firmy są dodawane automatycznie — wracaj po więcej!</p>
        </div>
      )}
    </main>

    <!-- Footer -->
    <footer class="mt-16 border-t border-gray-100 bg-gray-50 py-10">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 text-center text-sm text-gray-500 sm:flex-row sm:justify-between sm:text-left">
        <div>&copy; {new Date().getFullYear()} wizytowka.link</div>
        <div class="flex gap-6">
          <a href="/regulamin" class="hover:text-gray-700 transition-colors">Regulamin</a>
          <a href="/polityka-prywatnosci" class="hover:text-gray-700 transition-colors">Polityka prywatności</a>
        </div>
      </div>
    </footer>
  </body>
</html>
