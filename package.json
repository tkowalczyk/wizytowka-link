{
	"name": "wizytowka-link",
	"license": "CC-BY-NC-4.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "wrangler dev",
		"types": "wrangler types && astro check",
		"check": "astro check",
		"check:watch": "astro check --watch",
		"db:migrate": "wrangler d1 migrations apply leadgen --local",
		"db:migrate:remote": "wrangler d1 migrations apply leadgen --remote",
		"seed:create-sql": "tsx scripts/seed-localities.ts",
		"seed:into-d1": "tsx scripts/parse-simc.ts",
		"db:migrate:fresh": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/r2 && pnpm db:migrate",
		"seed": "pnpm db:migrate:fresh && pnpm tsx scripts/seed-local-test.ts",
		"deploy": "wrangler deploy",
		"deps": "taze",
		"deps:major": "taze major",
		"deps:up": "taze -w && pnpm i",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"lint:ci": "biome ci",
		"format": "biome format --write"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^12.6.13",
		"@tailwindcss/vite": "^4.2.4",
		"astro": "^5.18.1",
		"tailwindcss": "^4.2.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.8",
		"@biomejs/biome": "2.4.10",
		"@cloudflare/vitest-pool-workers": "^0.13.5",
		"@types/node": "^25.6.0",
		"playwright": "^1.59.1",
		"taze": "^19.11.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.5",
		"wrangler": "^4.84.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
