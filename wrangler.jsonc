{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wizytowka-link",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		// 1.0 — sample all events; low cron volume, revisit if traffic grows
		"head_sampling_rate": 1.0
	},
	"d1_databases": [
		{
			"binding": "leadgen",
			"database_name": "leadgen",
			"database_id": "71456b08-2012-4b06-bb67-de685866a6a1",
			"migrations_dir": "./migrations",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "sites",
			"binding": "sites",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "STATE",
			"id": "b308c972ce0745539757229a32a61591"
		}
	],
	"vars": {
		"DISCOVERY_MIN_QUOTA": "200"
	},
	// PAUSED 2026-08-28 — project on hold, all cron triggers disabled.
	// To resume: restore the list below and run `npx wrangler triggers deploy`.
	// "crons": [
	//   "0 * * * *",     // geocoder
	//   "55 7 * * *",    // preflight
	//   "0 8 * * *",     // discovery
	//   "*/5 * * * *",   // generate
	//   "*/10 * * * *",  // chatTimeout
	//   "0 9 * * 1",     // funnel
	//   "0 4 * * 1",     // reconcile
	// ]
	"triggers": {
		"crons": []
	},
	"routes": [
		{
			"pattern": "wizytowka.link",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS"
	}
}
